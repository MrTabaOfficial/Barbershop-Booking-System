# Copy this file to .env and adjust the values. .env is never committed.

# PostgreSQL container (read by docker compose)
POSTGRES_USER=barbershop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=barbershop
POSTGRES_PORT=5432

# Connection string used by the server and Prisma.
# Must match the four values above.
DATABASE_URL=postgresql://barbershop:change-me@localhost:5432/barbershop

# The shop's time zone, as an IANA name. Working hours and days off are in
# this zone; bookings are stored in UTC.
SHOP_TIME_ZONE=Asia/Tbilisi

# Port the API listens on
PORT=3000

# Where the website is served. Payment pages send the customer back here.
APP_URL=http://localhost:5173

# Stripe, in test mode. Leave both empty to use the built-in fake payment
# page, which needs no account. Set both to take test payments:
#   STRIPE_SECRET_KEY      from the Stripe dashboard (starts with sk_test_)
#   STRIPE_WEBHOOK_SECRET  printed by `stripe listen` (starts with whsec_)
# The README's "Payments" section has the steps.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Signs access tokens; at least 32 characters. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string

# Password given to every demo account created by the seed script
SEED_PASSWORD=demo-password
