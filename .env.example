# Copy this file to .env and adjust the values; .env is never committed.

POSTGRES_USER=barbershop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=barbershop
POSTGRES_PORT=5432

# Must match the four values above, which docker compose creates the
# database with.
DATABASE_URL=postgresql://barbershop:change-me@localhost:5432/barbershop

# An IANA name: working hours and days off are on this zone's clock, while
# bookings are stored in UTC.
SHOP_TIME_ZONE=Asia/Tbilisi

PORT=3000

# Where the website is served, because payment pages send the customer back
# here.
APP_URL=http://localhost:5173

# Leave both empty to use the built-in fake payment page, which needs no
# account; the README's "Payments" section says where Stripe's test keys
# come from.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mailpit, which docker compose starts, shows every email at
# http://localhost:8025 instead of delivering it; leave SMTP_HOST empty to
# have emails written to the server's log.
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_FROM="Dalaki <bookings@dalaki.example>"

# Leave both empty to have the owner's alerts written to the server's log;
# the README's "Notifications" section says how to get them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Signs access tokens, so it must be at least 32 characters, for example from:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string

SEED_PASSWORD=demo-password
