{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "esnext.temporal"],
    "module": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "prisma", "tests", "prisma.config.ts", "vitest.config.ts"]
}
