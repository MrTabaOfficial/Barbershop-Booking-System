{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    // Playwright runs the TypeScript directly, so tsc only type-checks.
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["*.ts", "tests"]
}
