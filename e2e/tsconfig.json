{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["*.ts", "tests"]
}
